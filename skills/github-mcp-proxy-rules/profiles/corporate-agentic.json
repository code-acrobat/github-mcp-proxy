{
  "schema": "github/github-mcp-server@v1.14.0",
  "deny_tools": [
    "merge_pull_request",
    "push_files",
    "create_or_update_file",
    "delete_file",
    "create_repository"
  ],
  "deny_calls": [
    {
      "tool": "pull_request_review_write",
      "if": { "event": "APPROVE" },
      "reason": "PR approvals are human-only"
    }
  ]
}
